# Copy this file to .env and adjust. `docker compose` reads .env from the
# repository root automatically. .env is gitignored, so real credentials must
# live there and never be committed.

# Grafana admin login for the local stacks (docker-compose.yml and
# docker-compose.full.yml). Anonymous viewer access is configured separately
# in the compose files and depends on nothing here.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Payment gateway. `mock` (default) keeps the stack self-contained; set it to
# `stripe` to route payments through the real Stripe API. In the sandbox the key
# looks like sk_test_... and the default test payment method is pm_card_visa.
PAYMENT_GATEWAY_PROVIDER=mock
# Optional: give payment-api (the webhook host) a different provider than the
# processor, e.g. PAYMENT_API_GATEWAY_PROVIDER=stripe to expose /webhooks/stripe
# locally while payments still run on the mock gateway. Falls back to
# PAYMENT_GATEWAY_PROVIDER.
# PAYMENT_API_GATEWAY_PROVIDER=stripe
STRIPE_API_KEY=
# Signing secret for inbound Stripe webhooks (`stripe listen` prints it as whsec_...).
# Required when the provider is stripe.
STRIPE_WEBHOOK_SECRET=
# Optional overrides: STRIPE_API_BASE, STRIPE_PAYMENT_METHOD.
