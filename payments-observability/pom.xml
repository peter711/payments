<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.softfal</groupId>
	<artifactId>payments-observability</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>payments-observability</name>
	<description>Shared Micrometer/Prometheus observability conventions for the payments services</description>

	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
	</properties>

	<dependencies>
		<!--
			Provides the @AutoConfiguration support used by the module.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<!--
			Brings the Micrometer metrics/observation auto-configuration and the
			MeterRegistryCustomizer callback used to attach the common tags.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-metrics</artifactId>
		</dependency>
		<!--
			The Prometheus registry. Having it on the classpath is enough for
			Spring Boot to expose /actuator/prometheus. Every service depends on
			this module, so the registry is declared exactly once.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!--
			Used by LogContext to attach the correlation context to the SLF4J MDC.
			The API only (the binding is provided by each service's logging
			starter), so the module stays free of a logging implementation.
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
